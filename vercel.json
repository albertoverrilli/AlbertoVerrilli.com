{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/anno", "destination": "https://www.thegameofguessinghistoricalevents.com/" },
    { "source": "/anno/", "destination": "https://www.thegameofguessinghistoricalevents.com/" },
    {
      "source": "/anno/:path+",
      "destination": "https://www.thegameofguessinghistoricalevents.com/:path+"
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
